# Copy to .env (gitignored) and fill in as adapters are wired.
# NEVER commit real credentials. Nested settings use the TFX_ prefix and __ delimiter.

# --- Runtime ---
# TFX_CACHE_DIR=data/cache
# TFX_SAMPLE_DIR=data/sample
# TFX_RAW_DIR=data/raw                  # raw provider snapshots (verbatim bytes + sha256)

# --- Data provider ---
# TFX_DATA__PROVIDER=fixture            # fixture | stooq (keyless) | (polygon|twelvedata|oanda|... later)
# TFX_DATA__PROVIDER_API_KEY=           # not needed for fixture/stooq
# TFX_DATA__PROVIDER_BASE_URL=

# --- Broker (Phase 2: live execution) ---
# TFX_BROKER__NAME=
# TFX_BROKER__API_KEY=
# TFX_BROKER__API_SECRET=
# TFX_BROKER__ACCOUNT_ID=
# TFX_BROKER__ENVIRONMENT=practice      # practice | live
